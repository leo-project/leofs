{minimum_otp_vsn, "28"}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_export_all,
    warn_unused_import,
    {d, 'NOTEST'}
]}.

{deps, [
    {leo_cache,             {git, "https://github.com/leo-project/leo_cache.git",             {tag, "v1.0.0"}}},
    {leo_commons,           {git, "https://github.com/leo-project/leo_commons.git",           {tag, "1.3.0"}}},
    {leo_object_storage,    {git, "https://github.com/leo-project/leo_object_storage.git",    {tag, "v2.1.0"}}},
    {leo_pod,               {git, "https://github.com/leo-project/leo_pod.git",               {tag, "0.7.0"}}},
    {leo_redundant_manager, {git, "https://github.com/leo-project/leo_redundant_manager.git", {tag, "v2.1.0"}}},
    {leo_s3_libs,           {git, "https://github.com/leo-project/leo_s3_libs.git",           {tag, "v2.1.0"}}},
    {leo_watchdog,          {git, "https://github.com/leo-project/leo_watchdog.git",          {tag, "v2.1.0"}}},
    {erpcgen,               {git, "https://github.com/leo-project/erpcgen.git",               {tag, "v0.3.0"}}},
    {nfs_rpc_server,        {git, "https://github.com/leo-project/nfs_rpc_server.git",        {tag, "v0.3.0"}}},
    {cowboy,                {git, "https://github.com/ninenines/cowboy.git",                  {tag, "2.12.0"}}},
    {cowlib,                {git, "https://github.com/ninenines/cowlib.git",                  {tag, "2.13.0"}}}
    %% sd_notify - only needed on Linux with systemd
    %% {sd_notify,             {git, "https://github.com/systemd/erlang-sd_notify.git",          {tag, "v1.1"}}}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{dialyzer, [
    {warnings, [
        unmatched_returns,
        error_handling,
        unknown
    ]},
    {plt_extra_apps, [crypto, mnesia, snmp, ssl, ranch, asn1]}
]}.

{cover_enabled, true}.
{cover_opts, [verbose]}.

{profiles, [
    {test, [
        {erl_opts, [
            debug_info,
            {d, 'TEST'}
        ]},
        {deps, [
            {meck, "0.9.2"}
        ]}
    ]}
]}.

{plugins, [
    rebar3_hex,
    rebar3_ex_doc
]}.

{project_plugins, [
    erlfmt
]}.

{erlfmt, [
    write,
    {files, ["src/*.erl", "include/*.hrl", "test/*.erl"]}
]}.

{ex_doc, [
    {source_url, <<"https://github.com/leo-project/leo_gateway">>},
    {extras, [<<"README.md">>, <<"LICENSE">>]},
    {main, <<"readme">>}
]}.

{hex, [{doc, ex_doc}]}.

%% Release configuration
{relx, [
    {release, {leo_gateway, "2.0.0"}, [
        %% Erlang/OTP applications
        kernel,
        stdlib,
        sasl,
        crypto,
        ssl,
        public_key,
        asn1,
        inets,
        mnesia,
        os_mon,
        snmp,
        runtime_tools,
        compiler,
        syntax_tools,
        tools,
        xmerl,
        %% LeoFS dependencies
        leo_commons,
        leo_cache,
        leo_backend_db,
        leo_mq,
        leo_redundant_manager,
        leo_object_storage,
        {leo_s3_libs, load},
        leo_watchdog,
        leo_rpc,
        leo_pod,
        leo_tran,
        elarm,
        nfs_rpc_server,
        erpcgen,
        %% Third-party dependencies
        ranch,
        cowboy,
        cowlib,
        eleveldb,
        %% sd_notify - only needed on Linux with systemd
        %% sd_notify,
        %% Main application
        leo_gateway
    ]},
    {dev_mode, false},
    {include_erts, true},
    {extended_start_script, true},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"},
    {overlay, [
        {mkdir, "work/mnesia"},
        {mkdir, "work/queue"},
        {mkdir, "log/sasl"},
        {mkdir, "etc/leo_gateway.d"},
        {mkdir, "snmp/snmpa_gateway_0/db"},
        {mkdir, "snmp/snmpa_gateway_0/agent/conf"},
        {mkdir, "snmp/snmpa_gateway_1/db"},
        {mkdir, "snmp/snmpa_gateway_1/agent/conf"},
        {copy, "priv/leo_gateway.conf", "etc/leo_gateway.conf"},
        {copy, "priv/leo_gateway.schema", "etc/leo_gateway.schema"},
        {copy, "priv/leo_gateway_snmp.yml", "etc/leo_gateway_snmp.yml"},
        {copy, "snmp/snmpa_gateway_0/LEO-GATEWAY.bin", "snmp/snmpa_gateway_0/LEO-GATEWAY.bin"},
        {copy, "snmp/snmpa_gateway_0/LEO-GATEWAY.mib", "snmp/snmpa_gateway_0/LEO-GATEWAY.mib"},
        {copy, "snmp/snmpa_gateway_0/leo_gateway_snmp.config", "snmp/snmpa_gateway_0/leo_gateway_snmp.config"},
        {copy, "snmp/snmpa_gateway_0/agent/conf/agent.conf", "snmp/snmpa_gateway_0/agent/conf/agent.conf"},
        {copy, "snmp/snmpa_gateway_0/agent/conf/community.conf", "snmp/snmpa_gateway_0/agent/conf/community.conf"},
        {copy, "snmp/snmpa_gateway_0/agent/conf/context.conf", "snmp/snmpa_gateway_0/agent/conf/context.conf"},
        {copy, "snmp/snmpa_gateway_0/agent/conf/standard.conf", "snmp/snmpa_gateway_0/agent/conf/standard.conf"},
        {copy, "snmp/snmpa_gateway_0/agent/conf/vacm.conf", "snmp/snmpa_gateway_0/agent/conf/vacm.conf"},
        {copy, "snmp/snmpa_gateway_0/agent/conf/notify.conf", "snmp/snmpa_gateway_0/agent/conf/notify.conf"},
        {copy, "snmp/snmpa_gateway_1/LEO-GATEWAY.bin", "snmp/snmpa_gateway_1/LEO-GATEWAY.bin"},
        {copy, "snmp/snmpa_gateway_1/LEO-GATEWAY.mib", "snmp/snmpa_gateway_1/LEO-GATEWAY.mib"},
        {copy, "snmp/snmpa_gateway_1/leo_gateway_snmp.config", "snmp/snmpa_gateway_1/leo_gateway_snmp.config"},
        {copy, "snmp/snmpa_gateway_1/agent/conf/agent.conf", "snmp/snmpa_gateway_1/agent/conf/agent.conf"},
        {copy, "snmp/snmpa_gateway_1/agent/conf/community.conf", "snmp/snmpa_gateway_1/agent/conf/community.conf"},
        {copy, "snmp/snmpa_gateway_1/agent/conf/context.conf", "snmp/snmpa_gateway_1/agent/conf/context.conf"},
        {copy, "snmp/snmpa_gateway_1/agent/conf/standard.conf", "snmp/snmpa_gateway_1/agent/conf/standard.conf"},
        {copy, "snmp/snmpa_gateway_1/agent/conf/vacm.conf", "snmp/snmpa_gateway_1/agent/conf/vacm.conf"},
        {copy, "snmp/snmpa_gateway_1/agent/conf/notify.conf", "snmp/snmpa_gateway_1/agent/conf/notify.conf"}
    ]}
]}.
