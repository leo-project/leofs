{minimum_otp_vsn, "28"}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_export_all,
    warn_unused_import,
    {d, 'NOTEST'}
]}.

{deps, [
    {leo_commons,           {git, "https://github.com/leo-project/leo_commons.git",           {tag, "1.3.0"}}},
    {leo_mq,                {git, "https://github.com/leo-project/leo_mq.git",                {tag, "v2.1.0"}}},
    {leo_object_storage,    {git, "https://github.com/leo-project/leo_object_storage.git",    {tag, "v2.1.0"}}},
    {leo_ordning_reda,      {git, "https://github.com/leo-project/leo_ordning_reda.git",      {tag, "v1.3.0"}}},
    {leo_redundant_manager, {git, "https://github.com/leo-project/leo_redundant_manager.git", {tag, "v2.1.0"}}},
    {leo_statistics,        {git, "https://github.com/leo-project/leo_statistics.git",        {tag, "v2.1.0"}}},
    {leo_watchdog,          {git, "https://github.com/leo-project/leo_watchdog.git",          {tag, "v2.1.0"}}},
    {sd_notify,             {git, "https://github.com/systemd/erlang-sd_notify.git",          {tag, "v1.1"}}}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{dialyzer, [
    {warnings, [
        unmatched_returns,
        error_handling,
        underspecs
    ]}
]}.

{cover_enabled, true}.
{cover_opts, [verbose]}.

{profiles, [
    {test, [
        {erl_opts, [
            debug_info,
            {d, 'TEST'}
        ]},
        {deps, [
            {meck, "0.9.2"}
        ]}
    ]}
]}.

{project_plugins, [
    rebar3_hex,
    rebar3_lint
]}.
