%% NOTE: This configuration file is for project-fifo integration.
%% It may need additional updates for compatibility with latest OTP.

{minimum_otp_vsn, "28"}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_export_all,
    warn_unused_import
]}.

{deps, [
    {fifo_utils, {git, "https://github.com/leo-project/fifo_utils.git", {ref, "6911b96d5bd813d3688108afb57746020c61daf2"}}}
]}.
